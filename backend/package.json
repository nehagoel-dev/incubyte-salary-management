    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
